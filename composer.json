{
    "name": "projeto-zebra/zebra-puzzle",
    "description": "Aplicação web do Zebra Puzzle modelado como CSP.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-gd": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*"
    },
    "autoload": {
        "psr-4": {
            "ZebraPuzzle\\": "src/"
        }
    },
    "scripts": {
        "test": "@php tests/run.php",
        "lint": "@php tests/run.php --lint",
        "test:fase7": "@php tests/fase7.php",
        "test:integration:fase7": "@php tests/integration_fase7.php",
        "test:fase6": "php tests/fase6.php",
        "test:integration": "php tests/integration_fase4.php",
        "test:integration:fase5": "php tests/integration_fase5.php",
        "test:integration:fase6": "php tests/integration_fase6.php",
        "desafio:validar": "php bin/validar-desafio-exemplo.php",
        "desafio:provisionar": "php bin/provisionar-desafio.php"
    },
    "config": {
        "sort-packages": true
    }
}
